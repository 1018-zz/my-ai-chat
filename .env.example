# 本地运行端口（node server.js 使用）
PORT=3000
HOST=0.0.0.0

# 前端请求后端地址：
# - 本地同域运行（npm start）可留空
# - 前端 dev server 连接后端时可填 http://localhost:3000
VITE_API_BASE=

# 必填：聊天模型 API Key
DEEPSEEK_API_KEY=

# 必填：数据库/记忆/日记等接口使用的 Supabase service role key
SUPABASE_SECRET_KEY=
SUPABASE_URL=

# 可选：代码库读取能力
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=

# 可选：工具/MCP/位置/天气相关能力
MCP_AUTH_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
AMAP_KEY=
LOCATION_TOKEN=
DRIFT_TOKEN=
GALATEA_TOKEN=
NOWHERE_API=

# 可选：上下文压缩参数，一般不用改
CONTEXT_MAX_TOKENS=
CONTEXT_OUTPUT_RESERVE=
CONTEXT_SAFETY_MARGIN=
